    let currentApps = [...jiaaraAppData];

    // --- LOGIKA UTAMA ---
    document.addEventListener("DOMContentLoaded", () => {
        updateJiaaraTime();
        renderJiaaraNotifs();
        renderJiaaraApps();
        setInterval(updateJiaaraTime, 1000);

        // Pencarian Aplikasi
        document.getElementById('jiaara-app-search').addEventListener('input', (e) => {
            const term = e.target.value.toLowerCase();
            const filtered = jiaaraAppData.filter(app => app.name.toLowerCase().includes(term));
            renderJiaaraApps(filtered);
        });
    });

    function updateJiaaraTime() {
        const now = new Date();
        const options = { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' };
        const timeStr = now.getHours().toString().padStart(2, '0') + ':' + now.getMinutes().toString().padStart(2, '0');
        const dateStr = now.toLocaleDateString('id-ID', options);
        
        document.getElementById('jiaara-time').innerText = timeStr;
        document.getElementById('jiaara-date').innerText = dateStr;
    }

    function renderJiaaraNotifs() {
        const container = document.getElementById('jiaara-notif-list');
        container.innerHTML = jiaaraNotifData.map((n, i) => `
            <a href="${n.link}" class="jiaara-biolink-notif-item" id="jiaara-notif-${i}">
                <img src="${n.img}" class="jiaara-biolink-notif-img">
                <div class="jiaara-biolink-notif-content">
                    <div class="jiaara-biolink-notif-header">
                        <span>${n.name}</span>
                        <span>Sekarang ▾</span>
                    </div>
                    <div class="jiaara-biolink-notif-body">${n.text}</div>
                </div>
            </a>
        `).join('');
    }

    function renderJiaaraApps(dataArr = currentApps) {
        const grid = document.getElementById('jiaara-app-grid');
        grid.innerHTML = dataArr.map(app => `
            <div class="jiaara-biolink-notif-app" onclick="jiaaraHandleAppClick('${app.type}', '${app.link}')">
                <img src="${app.img}" alt="${app.name}">
                <span>${app.name}</span>
            </div>
        `).join('');
    }

    async function jiaaraClearAllNotif() {
        const items = document.querySelectorAll('.jiaara-biolink-notif-item');
        // Animasi geser kiri satu per satu
        for (let i = 0; i < items.length; i++) {
            items[i].classList.add('jiaara-removing');
            await new Promise(r => setTimeout(r, 100));
        }
        
        // Transisi ke home screen
        setTimeout(() => {
            document.getElementById('jiaara-biolink-notif-lock').style.transform = 'translateY(-100%)';
            document.getElementById('jiaara-biolink-notif-home').style.transform = 'translateY(0)';
        }, 400);
    }

    function jiaaraBackToLock() {
        // Kembalikan layar lock ke posisi normal
        document.getElementById('jiaara-biolink-notif-lock').style.transform = 'translateY(0)';
        document.getElementById('jiaara-biolink-notif-home').style.transform = 'translateY(100%)';
        
        // Kembalikan semua notifikasi agar terlihat lagi
        const items = document.querySelectorAll('.jiaara-biolink-notif-item');
        items.forEach(item => {
            item.classList.remove('jiaara-removing');
        });
    }

    function jiaaraHandleAppClick(type, link) {
        if (type === 'wa') {
            alert('Maaf, tidak membagikan nomor pribadi');
        } else if (link && link !== '#') {
            window.open(link, '_blank');
        }
    }

    function jiaaraToggleMenu() {
        const menu = document.getElementById('jiaara-sort-menu');
        menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
    }

    function jiaaraSortApps(mode) {
        if (mode === 'az') {
            currentApps.sort((a, b) => a.name.localeCompare(b.name));
        } else {
            currentApps = [...jiaaraAppData];
        }
        renderJiaaraApps();
        jiaaraToggleMenu();
    }

    // Menutup menu jika klik di luar
    window.onclick = function(event) {
        if (!event.target.matches('.jiaara-biolink-notif-menu-trigger')) {
            document.getElementById('jiaara-sort-menu').style.display = 'none';
        }
    }
</script>
