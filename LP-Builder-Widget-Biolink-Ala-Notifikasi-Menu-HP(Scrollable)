        --jiaara-bg-home: url('https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEi-e18ALep0lRVvkGTBAK4r_j6u2mvI40vJKfJRSwcaHdIPBWQsaXCycXk5hgcDle1tCvz1WNspScUW9u2oM0qgwMXHZi_OBGhccalZs8BR6Lu2-tdar3kgoQvc1ds_OyahjtNw0D36ucoZPppRndt7YhL1OAxSaaQBw-bhIC5K5_ClYaR-ePPnEBrZT50/s1000/JIAARA.ID%20-%20ADHITYA%20RAMADHAN%20WALLPAPER%20MENU.jpg');
    }

    #jiaara-biolink-notif-wrapper {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 999999;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        overflow: hidden;
        background-color: #000;
    }

    /* LOCK SCREEN SECTION */
    .jiaara-biolink-notif-screen {
        position: absolute;
        width: 100%;
        height: 100%;
        transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        background-size: cover;
        background-position: center;
    }

    #jiaara-biolink-notif-lock {
        background-image: var(--jiaara-bg-lock);
        z-index: 10;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-top: 50px;
    }

    .jiaara-biolink-notif-lock-icon {
        font-size: 30px;
        margin-bottom: 10px;
        color: #000;
    }

    .jiaara-biolink-notif-time {
        font-size: 80px;
        font-weight: 300;
        color: #222;
        line-height: 1;
    }

    .jiaara-biolink-notif-date {
        font-size: 18px;
        font-weight: 500;
        color: #222;
        margin-bottom: 30px;
    }

    .jiaara-biolink-notif-container {
        width: 90%;
        max-width: 400px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .jiaara-biolink-notif-item {
        background-color: rgba(74, 164, 239, 0.7);
        backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
        border-radius: 18px;
        padding: 12px;
        color: white;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        text-decoration: none;
        transition: transform 0.4s ease, opacity 0.4s ease;
        position: relative;
    }
	
	

    /* Efek geser kiri */
    .jiaara-biolink-notif-item.jiaara-removing {
        transform: translateX(-120%);
        opacity: 0;
    }

    .jiaara-biolink-notif-img {
        width: 45px;
        height: 45px;
        border-radius: 8px;
        object-fit: cover;
    }

    .jiaara-biolink-notif-content {
        flex: 1;
    }

    .jiaara-biolink-notif-header {
        display: flex;
        justify-content: space-between;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .jiaara-biolink-notif-body {
        font-size: 13px;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .jiaara-biolink-notif-close-btn {
        margin-top: 30px;
        width: 45px;
        height: 45px;
        background: #ff4d4d;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        cursor: pointer;
        font-weight: bold;
        box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    }

    /* HOME SCREEN SECTION */
    #jiaara-biolink-notif-home {
        background-image: var(--jiaara-bg-home);
        z-index: 5;
        padding: 20px;
        box-sizing: border-box;
    }

    .jiaara-biolink-notif-search-bar {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(10px);
        border: 1px solid #4099ff;
        border-radius: 25px;
        padding: 8px 15px;
        display: flex;
        align-items: center;
        margin-bottom: 25px;
        position: relative;
    }

    .jiaara-biolink-notif-search-bar input {
        border: none;
        background: transparent;
        width: 100%;
        outline: none;
        padding-left: 10px;
        color: #333;
    }

    .jiaara-biolink-notif-menu-trigger {
        cursor: pointer;
        font-size: 20px;
        padding-left: 10px;
    }

    .jiaara-biolink-notif-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px 10px;
    
    /* Tambahan untuk membuat scrollable */
    max-height: 70vh; /* Sesuaikan tinggi agar tidak menabrak search bar */
    overflow-y: auto;
    padding: 10px;
    
    /* Agar scroll smooth di mobile */
    -webkit-overflow-scrolling: touch; 
}

    .jiaara-biolink-notif-app {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-decoration: none;
        color: #333;
        font-size: 11px;
        text-align: center;
    }

    .jiaara-biolink-notif-app img {
        width: 60px;
        height: 60px;
        border-radius: 14px;
        margin-bottom: 5px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        transition: transform 0.2s;
    }

    .jiaara-biolink-notif-app:active img {
        transform: scale(0.9);
    }

    .jiaara-biolink-notif-dropdown {
        position: absolute;
        right: 0;
        top: 45px;
        background: white;
        border-radius: 8px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        display: none;
        z-index: 100;
        min-width: 120px;
    }

    .jiaara-biolink-notif-dropdown div {
        padding: 10px 15px;
        cursor: pointer;
        border-bottom: 1px solid #eee;
        font-size: 14px;
        color: #333;
        text-align: left;
    }

    /* Swipe down handle */
    .jiaara-biolink-notif-handle {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 50px;
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 20;
        cursor: ns-resize;
    }

    .jiaara-biolink-notif-handle::after {
        content: '';
        width: 50px;
        height: 5px;
        background: rgba(0,0,0,0.2);
        border-radius: 3px;
    }
</style>

