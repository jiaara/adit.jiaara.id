<script>
/* =========================
   JIAARA SUPPORT FAQ
========================= */

(function(){

  const jiaaraSupportAnswers = {

    q1: `
      Kami membuka dukungan agar seluruh proyek non-profit seperti aplikasi,
      asset digital, konten edukasi dan eksperimen digital dapat terus berjalan
      dan berkembang secara gratis untuk semua orang.
    `,

    q2: `
      Dana digunakan untuk kebutuhan operasional seperti domain, server,
      maintenance aplikasi, pengembangan fitur baru, riset, dan produksi konten.
    `,

    q3: `
      Tidak wajib sama sekali. Dukungan bersifat sukarela dan tidak ada paksaan.
      Kamu tetap bisa menikmati seluruh konten gratis seperti biasa.
    `,

    q4: `
      Ya, nominal donasi sepenuhnya bebas dan dapat disesuaikan dengan kemampuanmu.
      Dukungan sekecil apapun sangat berarti bagi perkembangan project kami.
    `

  };

  const jiaaraSupportSelect = document.getElementById('jiaara-support-faq-select');
  const jiaaraSupportAnswer = document.getElementById('jiaara-support-answer');

  jiaaraSupportSelect.addEventListener('change', function(){

    const selected = this.value;

    if(jiaaraSupportAnswers[selected]){
      jiaaraSupportAnswer.innerHTML = jiaaraSupportAnswers[selected];
    } else {
      jiaaraSupportAnswer.innerHTML = 'Jawaban Akan Muncul di sini...';
    }

  });

})();
</script>
