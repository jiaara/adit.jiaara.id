<style>
  /* ===== CSS BANNER SLIDER ===== */
  /* CSS dengan Prefix jdp-promo- */
.jdp-promo-wrapper {
  display: flex;
  gap: 12px;
  width: 100%;
  max-width: 1000px;
  margin: 0 auto;
  font-family: Arial, sans-serif;
}

.jdp-promo-left-section {
  flex: 2.5;
  position: relative;
  overflow: hidden;
  border-radius: 15px;
  aspect-ratio: 16 / 7.5;
}

.jdp-promo-slider-container {
  width: 100%;
  height: 100%;
  position: relative;
}

.jdp-promo-slider-track {
  display: flex;
  transition: transform 0.5s ease-in-out;
  height: 100%;
}

.jdp-promo-slide {
  min-width: 100%;
  height: 100%;
}

.jdp-promo-slide img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Tombol Navigasi Kanan Bawah */
.jdp-promo-navigation {
  position: absolute;
  bottom: 15px;
  right: 15px;
  display: flex;
  gap: 8px;
  z-index: 10;
}

.jdp-promo-nav-btn {
  background: rgba(0, 0, 0, 0.3);
  color: white;
  border: none;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  transition: 0.3s;
}

.jdp-promo-nav-btn:hover {
  background: rgba(0, 0, 0, 0.6);
}

/* Dots Tengah Bawah */
.jdp-promo-dots-container {
  position: absolute;
  bottom: 15px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 6px;
  z-index: 10;
}

.jdp-promo-dot {
  width: 10px;
  height: 10px;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 50%;
  cursor: pointer;
  transition: 0.3s;
}

.jdp-promo-dot.active {
  background: #fff;
  width: 25px;
  border-radius: 10px;
}

/* Bagian Kanan */
.jdp-promo-right-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.jdp-promo-static-card {
  flex: 1;
  border-radius: 15px;
  overflow: hidden;
  display: block;
  box-shadow: 0 4px 6px rgba(0,0,0,0.1);
  transition: transform 0.3s;
}

.jdp-promo-static-card:hover {
  transform: translateY(-3px);
}

.jdp-promo-static-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Responsif Mobile */
@media (max-width: 768px) {
  .jdp-promo-wrapper {
    flex-direction: column;
  }
  .jdp-promo-left-section {
    aspect-ratio: 16 / 9;
  }
  .jdp-promo-right-section {
    flex-direction: row;
  }
}
</style>

