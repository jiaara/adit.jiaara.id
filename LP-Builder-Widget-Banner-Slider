<script>
// JavaScript untuk Slider Otomatis dan Manual
let jdpCurrentIndex = 0;
const jdpSlides = document.querySelectorAll('.jdp-promo-slide');
const jdpDots = document.querySelectorAll('.jdp-promo-dot');
const jdpTrack = document.getElementById('jdp-promo-sliderTrack');
const jdpTotalSlides = jdpSlides.length;

function updateJdpSlider() {
  jdpTrack.style.transform = `translateX(-${jdpCurrentIndex * 100}%)`;
  
  // Update dots
  jdpDots.forEach((dot, index) => {
    dot.classList.toggle('active', index === jdpCurrentIndex);
  });
}

function moveJdpSlide(direction) {
  jdpCurrentIndex += direction;
  if (jdpCurrentIndex >= jdpTotalSlides) jdpCurrentIndex = 0;
  if (jdpCurrentIndex < 0) jdpCurrentIndex = jdpTotalSlides - 1;
  updateJdpSlider();
  resetJdpTimer();
}

function currentJdpSlide(index) {
  jdpCurrentIndex = index;
  updateJdpSlider();
  resetJdpTimer();
}

// Auto Slide setiap 5 detik
let jdpAutoSlide = setInterval(() => {
  moveJdpSlide(1);
}, 5000);

function resetJdpTimer() {
  clearInterval(jdpAutoSlide);
  jdpAutoSlide = setInterval(() => {
    moveJdpSlide(1);
  }, 5000);
}
</script>
