    let skhcitizenAuto = setInterval(() => skhcitizenMoveSlider(1), 3000);

    const container = document.querySelector('.skhcitizen-donasi-container');
    container.onmouseenter = () => clearInterval(skhcitizenAuto);
    container.onmouseleave = () => skhcitizenAuto = setInterval(() => skhcitizenMoveSlider(1), 3000);

