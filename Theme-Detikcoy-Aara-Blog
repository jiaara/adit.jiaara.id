    function skhcitizenUpdateSlider(animate = true) {
        const visible = skhcitizenGetVisible();
        const stepWidth = 100 / visible;
        
        if (!animate) {
            skhcitizen_track.style.transition = 'none';
        } else {
            skhcitizen_track.style.transition = 'transform 0.5s ease-in-out';
        }

        skhcitizen_track.style.transform = `translateX(-${skhcitizen_currentIdx * stepWidth}%)`;
    }

    window.skhcitizenMoveSlider = function(step) {
        const visible = skhcitizenGetVisible();
        skhcitizen_currentIdx += step;

        skhcitizenUpdateSlider(true);

        setTimeout(() => {
            if (skhcitizen_currentIdx >= skhcitizen_originalCount) {
                skhcitizen_currentIdx = 0;
                skhcitizenUpdateSlider(false);
            } else if (skhcitizen_currentIdx < 0) {
                skhcitizen_currentIdx = skhcitizen_originalCount - 1;
                skhcitizenUpdateSlider(false);
            }
        }, 500);
