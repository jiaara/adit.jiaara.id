<script>
// JAVASCRIPT UNTUK DATA DINAMIS
let aditBioOriginalPosts = [];
let aditBioCurrentSort = 'newest';

// Fungsi mengambil data dari Blogger Feed
function aditBioLoadPosts() {
    const feedUrl = '/feeds/posts/default?alt=json&max-results=99';
    
    fetch(feedUrl)
        .then(response => response.json())
        .then(data => {
            const entries = data.feed.entry || [];
            aditBioOriginalPosts = entries.map(entry => {
                // Ambil gambar pertama dari post atau gambar default jika kosong
                let imgUrl = 'https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiwYq_n8mQzK2Z3J3Q5uX9U5N4V8v1pQ/s1600/default-thumb.png';
                if (entry.media$thumbnail) {
                    imgUrl = entry.media$thumbnail.url.replace('s72-c', 's200');
                } else if (entry.content && entry.content.$t.includes('<img')) {
                    const srcMatch = entry.content.$t.match(/src="([^"]+)"/);
                    if (srcMatch) imgUrl = srcMatch[1];
                }

                return {
                    title: entry.title.$t,
                    link: entry.link.find(l => l.rel === 'alternate').href,
                    image: imgUrl,
                    date: new Date(entry.published.$t)
                };
            });
            aditBioRender(aditBioOriginalPosts);
        })
        .catch(err => {
            document.getElementById('adit-bio-product-list').innerHTML = '<p style="color:red;text-align:center">Gagal memuat produk. Pastikan blog memiliki postingan.</p>';
        });
}

// Render list ke HTML
function aditBioRender(posts) {
    const listContainer = document.getElementById('adit-bio-product-list');
    if (posts.length === 0) {
        listContainer.innerHTML = '<div class="adit-bio-notfound">Maaf Produk Tidak Ditemukan, Silahkan Cek Kembali Penulisan Nomer/ Nama Produk</div>';
        return;
    }

    listContainer.innerHTML = posts.map(post => `
        <a href="${post.link}" class="adit-bio-item">
            <div class="adit-bio-thumb">
                <img src="${post.image}" alt="${post.title}">
            </div>
            <div class="adit-bio-prod-title">${post.title}</div>
        </a>
    `).join('');
}

// Fungsi Pencarian (Search)
function aditBioSearch() {
    const query = document.getElementById('adit-bio-input-search').value.toLowerCase();
    const filtered = aditBioOriginalPosts.filter(post => 
        post.title.toLowerCase().includes(query)
    );
    aditBioRender(filtered);
}

// Fungsi Sorting (Urutan)
function aditBioSort(type) {
    let sorted = [...aditBioOriginalPosts];
    
    if (type === 'toggle') {
        // Toggle Terbaru / Terlama
        if (aditBioCurrentSort === 'newest') {
            sorted.sort((a, b) => a.date - b.date);
            aditBioCurrentSort = 'oldest';
        } else {
            sorted.sort((a, b) => b.date - a.date);
            aditBioCurrentSort = 'newest';
        }
    } else if (type === 'az') {
        // A-Z / Z-A Toggle
        if (aditBioCurrentSort === 'az') {
            sorted.sort((a, b) => b.title.localeCompare(a.title));
            aditBioCurrentSort = 'za';
        } else {
            sorted.sort((a, b) => a.title.localeCompare(b.title));
            aditBioCurrentSort = 'az';
        }
    }
    
    aditBioRender(sorted);
}

// Jalankan fungsi saat halaman dimuat
aditBioLoadPosts();
</script>
