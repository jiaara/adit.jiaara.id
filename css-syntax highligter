/* --- Pengaturan Kontainer Utama Syntax Highlighter --- */
.css71aara-Syntax-highlighter-wrapper {
  border: 1px solid #e5e7eb;
  border-radius: 8px;
  overflow: hidden;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  margin: 20px 0;
  background-color: #fff;
}

/* --- Pengaturan Navigasi Tab --- */
.css71aara-Syntax-highlighter-tabs {
  display: flex;
  padding: 0 8px;
  border-bottom: 1px solid #e5e7eb;
}

.css71aara-Syntax-highlighter-tab {
  padding: 16px 16px;
  border: none;
  background: transparent;
  cursor: pointer;
  font-weight: 700;
  font-size: 14px;
  color: #6b7280;
  border-bottom: 3px solid transparent;
  transition: all 0.2s ease;
}

.css71aara-Syntax-highlighter-tab:hover {
  color: #111827;
}

.css71aara-Syntax-highlighter-tab.active {
  color: #111827;
  border-bottom: 3px solid #3b82f6;
}

/* --- Pengaturan Area Kode & Panel --- */
.css71aara-Syntax-highlighter-content {
  background-color: #212529;
  padding: 16px;
}

.css71aara-Syntax-highlighter-pane {
  display: none;
}

.css71aara-Syntax-highlighter-pane.active {
  display: block;
}

.css71aara-Syntax-highlighter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.css71aara-Syntax-highlighter-filename {
  font-family: Consolas, Monaco, monospace;
  font-size: 13px;
  font-weight: bold;
  color: #e5e7eb;
}

.css71aara-Syntax-highlighter-copy-btn {
  background-color: #fff;
  border: none;
  border-radius: 50%;
  width: 32px;
  height: 32px;
  display: flex;
  justify-content: center;
  align-items: center;
  cursor: pointer;
  transition: background-color 0.2s ease;
}

.css71aara-Syntax-highlighter-copy-btn:hover {
  background-color: #f3f4f6;
}

.css71aara-Syntax-highlighter-copy-btn svg {
  width: 16px;
  height: 16px;
  stroke: #374151;
}

/* --- Pengaturan Teks Kode & Pewarnaan --- */
.css71aara-Syntax-highlighter-pre {
  margin: 0;
  padding: 0;
  overflow-x: auto;
}

.css71aara-Syntax-highlighter-code {
  font-family: Consolas, Monaco, 'Andale Mono', monospace;
  font-size: 14px;
  line-height: 1.6;
  color: #d4d4d4;
}

/* Kelas Pewarnaan Sintaks */
.css71aara-Syntax-highlighter-c-tag { color: #8bc34a; } 
.css71aara-Syntax-highlighter-c-attr { color: #ff5252; } 
.css71aara-Syntax-highlighter-c-val { color: #ffb300; } 
.css71aara-Syntax-highlighter-c-text { color: #ffffff; } 
.css71aara-Syntax-highlighter-c-comment { color: #6b7280; font-style: italic; }
