<script>
    const aditBioConfig = {
        labelKhusus: 'affiliate', // Postingan harus punya label ini
        maxResults: 999,
        itemsPerPage: 10 // Konfigurasi maksimal 10 produk per halaman
    };

    let aditBioAllPosts = [];
    let aditBioFilteredPosts = []; // Menyimpan array yang sudah difilter
    let aditBioCategories = new Set();
    let aditBioCurrentPage = 1;

    async function aditBioFetchPosts() {
        const feedUrl = `/feeds/posts/default/-/${aditBioConfig.labelKhusus}?alt=json&max-results=${aditBioConfig.maxResults}`;
        
        try {
            const response = await fetch(feedUrl);
            const data = await response.json();
            
            if (data.feed.entry) {
                aditBioAllPosts = data.feed.entry.map(entry => {
                    const title = entry.title.$t;
                    const link = entry.link.find(l => l.rel === 'alternate').href;
                    
                    let imgUrl = 'https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEh8V35_v_Gg9K-O0qO3M4zZ5v9v8v7v6v5v4v3v2v1v0v_v-v_v8v7v6v5v4v3v2v1v0v/s1600/cloud-placeholder.png';
                    if (entry.media$thumbnail) {
                        imgUrl = entry.media$thumbnail.url.replace('s72-c', 's1600');
                    } else if (entry.content && entry.content.$t.includes('<img')) {
                        const div = document.createElement('div');
                        div.innerHTML = entry.content.$t;
                        imgUrl = div.querySelector('img').src;
                    }

                    const cats = entry.category ? entry.category.filter(c => c.term !== aditBioConfig.labelKhusus).map(c => c.term) : [];
                    cats.forEach(c => aditBioCategories.add(c));

                    return {
                        title: title,
                        link: link,
                        img: imgUrl,
                        date: new Date(entry.published.$t),
                        categories: cats
                    };
                });
                
                aditBioFilteredPosts = [...aditBioAllPosts]; // Copy data ke array filter
                aditBioPopulateCategories();
                aditBioRenderPage(); // Render halaman pertama
            } else {
                document.getElementById('adit-bio-container').innerHTML = '<div class="adit-bio-no-result">Belum ada produk dengan label "' + aditBioConfig.labelKhusus + '"</div>';
            }
        } catch (error) {
            console.error("Gagal memuat feed Blogger", error);
            document.getElementById('adit-bio-container').innerHTML = '<div class="adit-bio-no-result">Gagal memuat data.</div>';
        }
    }

    function aditBioPopulateCategories() {
        const select = document.getElementById('adit-bio-category-select');
        aditBioCategories.forEach(cat => {
            const opt = document.createElement('option');
            opt.value = cat;
            opt.textContent = cat;
            select.appendChild(opt);
        });
    }

    // Fungsi Render Khusus Halaman
    function aditBioRenderPage() {
        const start = (aditBioCurrentPage - 1) * aditBioConfig.itemsPerPage;
        const end = start + aditBioConfig.itemsPerPage;
        const paginatedPosts = aditBioFilteredPosts.slice(start, end);
        
        aditBioRender(paginatedPosts);
        aditBioRenderPagination();
    }

    function aditBioRender(posts) {
        const container = document.getElementById('adit-bio-container');
        container.innerHTML = '';

        if (posts.length === 0) {
            container.innerHTML = '<div class="adit-bio-no-result">Maaf Produk Tidak Ditemukan, Silahkan Cek Kembali Penulisan Nomer/ Nama Produk</div>';
            return;
        }

        posts.forEach(post => {
            const item = document.createElement('a');
            item.className = 'adit-bio-item';
            item.href = post.link;
            item.innerHTML = `
                <div class="adit-bio-item-img-container">
                    <img class="adit-bio-item-img" src="${post.img}" alt="${post.title}">
                </div>
                <div class="adit-bio-item-title">${post.title}</div>
            `;
            container.appendChild(item);
        });
    }

    // Render Tombol Pagination
    function aditBioRenderPagination() {
        const container = document.getElementById('adit-bio-pagination');
        container.innerHTML = '';
        
        const totalPages = Math.ceil(aditBioFilteredPosts.length / aditBioConfig.itemsPerPage);
        
        if (totalPages <= 1) return; // Sembunyikan pagination jika produk kurang dari 10

        // Tombol Prev
        const prevBtn = document.createElement('button');
        prevBtn.className = 'adit-bio-page-btn';
        prevBtn.innerHTML = '&#171;'; // Tanda panah ke kiri
        prevBtn.disabled = aditBioCurrentPage === 1;
        prevBtn.onclick = () => aditBioChangePage(aditBioCurrentPage - 1);
        container.appendChild(prevBtn);

        // Logic Angka Halaman (Max tampil 5 angka di tengah)
        let startPage = Math.max(1, aditBioCurrentPage - 2);
        let endPage = Math.min(totalPages, startPage + 4);
        if (endPage - startPage < 4) {
            startPage = Math.max(1, endPage - 4);
        }

        for (let i = startPage; i <= endPage; i++) {
            const btn = document.createElement('button');
            btn.className = `adit-bio-page-btn ${i === aditBioCurrentPage ? 'active' : ''}`;
            btn.innerText = i;
            btn.onclick = () => aditBioChangePage(i);
            container.appendChild(btn);
        }

        // Tombol Next
        const nextBtn = document.createElement('button');
        nextBtn.className = 'adit-bio-page-btn';
        nextBtn.innerHTML = '&#187;'; // Tanda panah ke kanan
        nextBtn.disabled = aditBioCurrentPage === totalPages;
        nextBtn.onclick = () => aditBioChangePage(aditBioCurrentPage + 1);
        container.appendChild(nextBtn);
    }

    // Aksi Pindah Halaman & Scroll
    function aditBioChangePage(page) {
        aditBioCurrentPage = page;
        aditBioRenderPage();
        
        // Smooth scroll ke List Produk
        const section = document.getElementById('adit-bio-section');
        if (section) {
            section.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    }

    // Fungsi Search & Filter
    function aditBioApplyFilters() {
        const searchTerm = document.getElementById('adit-bio-search-input').value.toLowerCase();
        const sortType = document.getElementById('adit-bio-sort-select').value;
        const catType = document.getElementById('adit-bio-category-select').value;

        aditBioFilteredPosts = aditBioAllPosts.filter(p => {
            const matchSearch = p.title.toLowerCase().includes(searchTerm);
            const matchCat = (catType === 'all') || p.categories.includes(catType);
            return matchSearch && matchCat;
        });

        // Sorting
        if (sortType === 'newest') aditBioFilteredPosts.sort((a, b) => b.date - a.date);
        if (sortType === 'oldest') aditBioFilteredPosts.sort((a, b) => a.date - b.date);
        if (sortType === 'az') aditBioFilteredPosts.sort((a, b) => a.title.localeCompare(b.title));
        if (sortType === 'za') aditBioFilteredPosts.sort((a, b) => b.title.localeCompare(a.title));

        // Reset ke halaman 1 tiap kali filter/search dijalankan
        aditBioCurrentPage = 1; 
        aditBioRenderPage();
    }

    // Events
    document.getElementById('adit-bio-search-input').addEventListener('input', aditBioApplyFilters);
    document.getElementById('adit-bio-sort-select').addEventListener('change', aditBioApplyFilters);
    document.getElementById('adit-bio-category-select').addEventListener('change', aditBioApplyFilters);
    
    document.getElementById('adit-bio-filter-toggle').addEventListener('click', () => {
        const opts = document.getElementById('adit-bio-filter-options');
        opts.style.display = opts.style.display === 'block' ? 'none' : 'block';
    });

    // Inisialisasi
    window.onload = aditBioFetchPosts;
</script>
