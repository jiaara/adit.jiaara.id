<!-- KODE CSS ADIT-BIO -->
<style>
    .adit-bio-wrapper {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        max-width: 1000px;
        margin: 0 auto;
        background-color: #ffffff;
        min-height: 100vh;
        color: #333;
        padding-bottom: 50px;
    }

    .adit-bio-header-bg {
        width: 100%;
        height: 180px;
        background: url('https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEitG7hYfN-P0Y7S_4V9j9_1f0o_1z_1y_1x_1w_1v_1u_1t_1s_1r_1q_1p_1o_1n_1m_1l_1k_1j_1i_1h_1g_1f_1e_1d_1c_1b_1a/s1600/header-dummy.jpg') center/cover no-repeat;
        position: relative;
    }

    .adit-bio-profile-section {
        text-align: center;
        margin-top: -65px;
        position: relative;
        padding: 0 20px;
    }

    .adit-bio-avatar {
        width: 130px;
        height: 130px;
        border-radius: 50%;
        border: 4px solid #fff;
        object-fit: cover;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .adit-bio-name {
        font-size: 32px;
        font-weight: 800;
        color: #b31a1a;
        margin: 15px 0 5px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

    .adit-bio-verified-icon {
        color: #1DA1F2;
        width: 24px;
        height: 24px;
    }

    .adit-bio-short-bio {
        font-size: 15px;
        font-style: italic;
        color: #333;
        margin-bottom: 15px;
    }

    .adit-bio-short-bio a {
        color: #007bff;
        text-decoration: none;
        font-weight: bold;
    }

    .adit-bio-social-icons {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-bottom: 25px;
    }

    .adit-bio-social-icons a svg {
        width: 32px;
        height: 32px;
        fill: #b31a1a;
    }

    .adit-bio-list-title {
        font-weight: 700;
        font-size: 22px;
        margin-bottom: 15px;
        text-align: center;
        /* Tambahkan scroll-margin agar saat digulir tidak tertutup elemen lain */
        scroll-margin-top: 20px; 
    }

    /* Search & Filter Bar */
    .adit-bio-search-container {
        display: flex;
        align-items: center;
        padding: 0 20px;
        gap: 10px;
        margin-bottom: 20px;
    }

    .adit-bio-search-box {
        flex-grow: 1;
        position: relative;
        display: flex;
        align-items: center;
        border: 2px solid #b31a1a;
        border-radius: 25px;
        padding: 5px 15px;
    }

    .adit-bio-search-box input {
        border: none;
        outline: none;
        width: 100%;
        padding: 8px;
        font-size: 16px;
    }

    .adit-bio-search-box svg {
        width: 20px;
        height: 20px;
        fill: #b31a1a;
    }

    .adit-bio-filter-btn {
        background: none;
        border: none;
        cursor: pointer;
    }

    .adit-bio-filter-btn svg {
        width: 30px;
        height: 30px;
        fill: #b31a1a;
    }

    /* Filter Dropdown */
    #adit-bio-filter-options {
        display: none;
        margin: 0 20px 20px;
        padding: 15px;
        background: #f8f8f8;
        border-radius: 10px;
        border: 1px solid #ddd;
    }

    #adit-bio-filter-options select {
        width: 100%;
        padding: 10px;
        border-radius: 5px;
        margin-top: 5px;
    }

    /* Product List Area */
    .adit-bio-product-list {
        padding: 0 20px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .adit-bio-item {
        display: flex;
        align-items: center;
        background-color: #b31a1a;
        border-radius: 30px;
        padding: 8px;
        text-decoration: none;
        transition: transform 0.2s;
    }

    .adit-bio-item:hover {
        transform: scale(1.02);
    }

    .adit-bio-item-img-container {
        width: 55px;
        height: 55px;
        background: #fff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .adit-bio-item-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .adit-bio-item-title {
        color: white;
        font-weight: 600;
        font-size: 18px;
        margin-left: 20px;
    }

    .adit-bio-no-result {
        text-align: center;
        color: #666;
        padding: 20px;
        font-style: italic;
    }

    /* Pagination CSS Baru */
    .adit-bio-pagination {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-top: 25px;
        padding: 0 20px;
        flex-wrap: wrap;
    }

    .adit-bio-page-btn {
        padding: 8px 14px;
        border: 2px solid #b31a1a;
        background: white;
        color: #b31a1a;
        border-radius: 8px;
        cursor: pointer;
        font-weight: bold;
        transition: all 0.2s;
    }

    .adit-bio-page-btn:hover, .adit-bio-page-btn.active {
        background: #b31a1a;
        color: white;
    }

    .adit-bio-page-btn:disabled {
        border-color: #ddd;
        color: #aaa;
        cursor: not-allowed;
        background: #f9f9f9;
    }

    .adit-bio-footer {
        text-align: center;
        margin-top: 30px;
        padding: 0 20px;
    }

    .adit-bio-url {
        font-weight: bold;
        font-size: 18px;
        color: #333;
        margin-bottom: 5px;
    }

    .adit-bio-location {
        font-size: 14px;
        color: #555;
    }
</style>

