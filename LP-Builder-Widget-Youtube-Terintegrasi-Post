<style>
  /* =========================================
     CSS JIAARA YOUTUBE GALLERY
     Semua class menggunakan prefix jiaara-youtube- 
     ========================================= */
  @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;700;800&display=swap');

  .jiaara-youtube-wrapper {
    font-family: 'Nunito', sans-serif;
    max-width: 1800px;
    margin: 0 auto;
    color: #333;
  }

  /* Header */
  .jiaara-youtube-header {
    text-align: center;
    margin-bottom: 25px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .jiaara-youtube-header h1 {
    font-size: 3rem;
    font-weight: 800;
    color: #3195EB;
    margin: 0;
    letter-spacing: 1px;
  }
  .jiaara-youtube-badge {
    width: 35px;
    height: 35px;
    background-color: #A6A6A6;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .jiaara-youtube-badge svg {
    fill: white;
    width: 20px;
    height: 20px;
  }

  /* Search & Filter Row */
  .jiaara-youtube-controls-row {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 20px;
  }
  .jiaara-youtube-search-container {
    flex-grow: 1;
    display: flex;
    border: 3px solid #3195EB;
    border-radius: 35px;
    overflow: hidden;
    height: 50px;
  }
  .jiaara-youtube-search-input {
    flex-grow: 1;
    border: none;
    padding: 0 20px;
    font-size: 1.5rem;
    color: #555;
    outline: none;
    font-family: inherit;
  }
  .jiaara-youtube-search-input::placeholder {
    color: #aaa;
  }
  .jiaara-youtube-search-btn {
    background-color: #3195EB;
    border: none;
    width: 60px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }
  .jiaara-youtube-search-btn:hover {
    background-color: #257bc5;
  }
  .jiaara-youtube-search-btn svg {
    fill: white;
    width: 24px;
    height: 24px;
  }
  .jiaara-youtube-filter-toggle {
    background: none;
    border: none;
    cursor: pointer;
    padding: 5px;
  }
  .jiaara-youtube-filter-toggle svg {
    fill: #3195EB;
    width: 40px;
    height: 40px;
  }

  /* Filter Panel (Hidden by default) */
  .jiaara-youtube-filter-panel {
    display: none;
    background: #f8f9fa;
    border: 1px solid #ddd;
    border-radius: 10px;
    padding: 15px;
    margin-bottom: 20px;
    gap: 15px;
    flex-wrap: wrap;
  }
  .jiaara-youtube-filter-panel.active {
    display: flex;
  }
  .jiaara-youtube-filter-select {
    padding: 8px 12px;
    border-radius: 5px;
    border: 1px solid #ccc;
    font-family: inherit;
    font-size: 1.5rem;
    outline: none;
  }

  /* Grid Layout */
  .jiaara-youtube-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 30px;
  }
  @media (max-width: 768px) {
    .jiaara-youtube-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 480px) {
    .jiaara-youtube-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Video Card */
  .jiaara-youtube-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .jiaara-youtube-thumb-wrap {
    position: relative;
    width: 100%;
    padding-top: 56.25%; /* 16:9 Aspect Ratio */
    border-radius: 12px;
    overflow: hidden;
    background-color: #e0f2fe; /* Fallback color */
  }
  .jiaara-youtube-thumb {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .jiaara-youtube-title {
    font-size: 1.55rem;
    font-weight: 800;
    line-height: 1.3;
    color: #111;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-decoration: none;
  }
  .jiaara-youtube-title:hover {
    color: #3195EB;
  }

  /* Empty State */
  .jiaara-youtube-empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 50px 20px;
    font-size: 1.2rem;
    color: #777;
    font-weight: 700;
  }

  /* Pagination */
  .jiaara-youtube-pagination {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 20px;
    margin-bottom: 40px;
  }
  .jiaara-youtube-page-btn {
    padding: 6px 12px;
    border: 1px solid #ccc;
    background: white;
    border-radius: 4px;
    cursor: pointer;
    font-weight: 700;
    color: #555;
    transition: all 0.2s;
  }
  .jiaara-youtube-page-btn:hover {
    background: #f0f0f0;
  }
  .jiaara-youtube-page-btn.active {
    background: #3195EB;
    color: white;
    border-color: #3195EB;
  }
  .jiaara-youtube-page-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>

<div class="jiaara-youtube-wrapper">
  
  <div class="jiaara-youtube-header">
    <h1>@ADIT.LAB</h1>
    <div class="jiaara-youtube-badge">
      <svg viewbox="0 0 24 24"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/></path></svg>
    </div>
  </div>

  <div class="jiaara-youtube-controls-row">
    <div class="jiaara-youtube-search-container">
      <input type="text" id="jiaara-youtube-search-input" class="jiaara-youtube-search-input" placeholder="Cari Video Panjang Adit di sini ..." />
      <button class="jiaara-youtube-search-btn" id="jiaara-youtube-search-btn">
        <svg viewbox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></path></svg>
      </button>
    </div>
    <button class="jiaara-youtube-filter-toggle" id="jiaara-youtube-filter-toggle" title="Filter">
      <svg viewbox="0 0 24 24"><path d="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"/></path></svg>
    </button>
  </div>

  <div class="jiaara-youtube-filter-panel" id="jiaara-youtube-filter-panel">
    <select class="jiaara-youtube-filter-select" id="jiaara-youtube-sort-select">
      <option value="newest">Tanggal: Terbaru</option>
      <option value="oldest">Tanggal: Terlama</option>
    </select>
    <select class="jiaara-youtube-filter-select" id="jiaara-youtube-label-select">
      <option value="all">Semua Label Kedua</option>
    </select>
  </div>

  <div class="jiaara-youtube-grid" id="jiaara-youtube-grid">
    </div>

  <div class="jiaara-youtube-pagination" id="jiaara-youtube-pagination">
    </div>

</div>

<script>
  /* =========================================
     JAVASCRIPT JIAARA YOUTUBE GALLERY
     ========================================= */
  let jiaaraYoutubeAllPosts = [];
  let jiaaraYoutubeFilteredPosts = [];
  let jiaaraYoutubeAllLabels = new Set();
  
  let jiaaraYoutubeCurrentPage = 1;
  const jiaaraYoutubeItemsPerPage = 6;

  // Elemen DOM
  const jiaaraGrid = document.getElementById('jiaara-youtube-grid');
  const jiaaraPagination = document.getElementById('jiaara-youtube-pagination');
  const jiaaraSearchInput = document.getElementById('jiaara-youtube-search-input');
  const jiaaraFilterToggle = document.getElementById('jiaara-youtube-filter-toggle');
  const jiaaraFilterPanel = document.getElementById('jiaara-youtube-filter-panel');
  const jiaaraSortSelect = document.getElementById('jiaara-youtube-sort-select');
  const jiaaraLabelSelect = document.getElementById('jiaara-youtube-label-select');

  // URL API Feed Blogger (Mengambil post dengan label 'youtube')
  const jiaaraYoutubeFeedUrl = '/feeds/posts/default/-/youtube?alt=json&max-results=150';

  // Inisialisasi
  function jiaaraYoutubeInit() {
    jiaaraGrid.innerHTML = '<div class="jiaara-youtube-empty">Memuat Video...</div>';
    
    fetch(jiaaraYoutubeFeedUrl)
      .then(response => {
        if (!response.ok) throw new Error('Gagal memuat feed');
        return response.json();
      })
      .then(data => {
        if (!data.feed.entry) {
          jiaaraGrid.innerHTML = '<div class="jiaara-youtube-empty">Maaf Video Tidak Ditemukan</div>';
          return;
        }
        jiaaraYoutubeProcessData(data.feed.entry);
      })
      .catch(err => {
        console.error(err);
        jiaaraGrid.innerHTML = '<div class="jiaara-youtube-empty">Terjadi kesalahan saat memuat data.</div>';
      });
  }

  // Proses Data JSON dari Blogger
  function jiaaraYoutubeProcessData(entries) {
    jiaaraYoutubeAllPosts = entries.map(entry => {
      // 1. Ambil URL Post
      const linkObj = entry.link.find(l => l.rel === 'alternate');
      const postUrl = linkObj ? linkObj.href : '#';

      // 2. Ambil Judul
      const title = entry.title.$t;

      // 3. Ambil Thumbnail HD (Blogger & YouTube)
      let rawThumbUrl = '';
      let thumbnail = '';

      if (entry.media$thumbnail) {
        rawThumbUrl = entry.media$thumbnail.url;
      } else if (entry.content && entry.content.$t.match(/<img[^>]+src="([^">]+)"/)) {
        rawThumbUrl = entry.content.$t.match(/<img[^>]+src="([^">]+)"/)[1];
      } else {
        rawThumbUrl = 'https://via.placeholder.com/1280x720.png?text=No+Image';
      }

      if (rawThumbUrl.includes('ytimg.com') || rawThumbUrl.includes('youtube.com')) {
        thumbnail = rawThumbUrl.replace(/(default|hqdefault|mqdefault|sddefault)\.jpg/i, 'maxresdefault.jpg');
      } else if (rawThumbUrl.match(/\/(s\d+|w\d+-h\d+)(\-c)?\//)) {
        thumbnail = rawThumbUrl.replace(/\/(s\d+|w\d+-h\d+)(\-c)?\//, '/w1280-h720-c/');
      } else {
        thumbnail = rawThumbUrl;
      }

      // 4. Ambil Tanggal
      const published = new Date(entry.published.$t);

      // 5. Ambil Label Kedua (Simpan dalam Array agar semua label terdeteksi)
      let labels = entry.category ? entry.category.map(c => c.term) : [];
      let labelKeduaArray = []; // Menggunakan Array di sini
      labels.forEach(lbl => {
        if (lbl.toLowerCase() !== 'youtube') {
          labelKeduaArray.push(lbl);
          jiaaraYoutubeAllLabels.add(lbl);
        }
      });

      return { title, postUrl, thumbnail, published, labelKeduaArray };
    });

    // Populate dropdown label
    jiaaraYoutubeAllLabels.forEach(lbl => {
      const option = document.createElement('option');
      option.value = lbl;
      option.textContent = lbl;
      jiaaraLabelSelect.appendChild(option);
    });

    jiaaraYoutubeFilteredPosts = [...jiaaraYoutubeAllPosts];
    jiaaraYoutubeRenderGrid();
  }

  // Render Grid Video
  function jiaaraYoutubeRenderGrid() {
    jiaaraGrid.innerHTML = '';

    if (jiaaraYoutubeFilteredPosts.length === 0) {
      jiaaraGrid.innerHTML = '<div class="jiaara-youtube-empty">Maaf Video Tidak Ditemukan</div>';
      jiaaraPagination.innerHTML = '';
      return;
    }

    const startIndex = (jiaaraYoutubeCurrentPage - 1) * jiaaraYoutubeItemsPerPage;
    const endIndex = startIndex + jiaaraYoutubeItemsPerPage;
    const currentItems = jiaaraYoutubeFilteredPosts.slice(startIndex, endIndex);

    currentItems.forEach(post => {
      const card = document.createElement('div');
      card.className = 'jiaara-youtube-card';
      
      card.innerHTML = `
        <a href="${post.postUrl}" class="jiaara-youtube-thumb-wrap">
          <img src="${post.thumbnail}" alt="${post.title}" class="jiaara-youtube-thumb">
        </a>
        <a href="${post.postUrl}" class="jiaara-youtube-title">${post.title}</a>
      `;
      jiaaraGrid.appendChild(card);
    });

    jiaaraYoutubeRenderPagination();
  }

  // Render Tombol Pagination
  function jiaaraYoutubeRenderPagination() {
    jiaaraPagination.innerHTML = '';
    const totalPages = Math.ceil(jiaaraYoutubeFilteredPosts.length / jiaaraYoutubeItemsPerPage);

    if (totalPages <= 1) return;

    const btnPrev = document.createElement('button');
    btnPrev.className = 'jiaara-youtube-page-btn';
    btnPrev.innerHTML = '&laquo;';
    btnPrev.disabled = jiaaraYoutubeCurrentPage === 1;
    btnPrev.addEventListener('click', () => {
      if (jiaaraYoutubeCurrentPage > 1) {
        jiaaraYoutubeCurrentPage--;
        jiaaraYoutubeRenderGrid();
      }
    });
    jiaaraPagination.appendChild(btnPrev);

    for (let i = 1; i <= totalPages; i++) {
      const btnPage = document.createElement('button');
      btnPage.className = 'jiaara-youtube-page-btn';
      if (i === jiaaraYoutubeCurrentPage) btnPage.classList.add('active');
      btnPage.textContent = i;
      btnPage.addEventListener('click', () => {
        jiaaraYoutubeCurrentPage = i;
        jiaaraYoutubeRenderGrid();
      });
      jiaaraPagination.appendChild(btnPage);
    }

    const btnNext = document.createElement('button');
    btnNext.className = 'jiaara-youtube-page-btn';
    btnNext.innerHTML = '&raquo;';
    btnNext.disabled = jiaaraYoutubeCurrentPage === totalPages;
    btnNext.addEventListener('click', () => {
      if (jiaaraYoutubeCurrentPage < totalPages) {
        jiaaraYoutubeCurrentPage++;
        jiaaraYoutubeRenderGrid();
      }
    });
    jiaaraPagination.appendChild(btnNext);
  }

  // Fungsi Filter & Search Logic
  function jiaaraYoutubeApplyFilters() {
    const searchQuery = jiaaraSearchInput.value.toLowerCase();
    const sortValue = jiaaraSortSelect.value;
    const labelValue = jiaaraLabelSelect.value;

    // 1. Filter Search & Label menggunakan .includes() pada Array
    jiaaraYoutubeFilteredPosts = jiaaraYoutubeAllPosts.filter(post => {
      const matchSearch = post.title.toLowerCase().includes(searchQuery);
      const matchLabel = (labelValue === 'all') || post.labelKeduaArray.includes(labelValue);
      return matchSearch && matchLabel;
    });

    // 2. Sorting Tanggal
    jiaaraYoutubeFilteredPosts.sort((a, b) => {
      if (sortValue === 'newest') {
        return b.published - a.published;
      } else {
        return a.published - b.published;
      }
    });

    // Reset ke halaman 1 setiap kali filter diubah
    jiaaraYoutubeCurrentPage = 1;
    jiaaraYoutubeRenderGrid();
  }

  // Event Listeners
  jiaaraSearchInput.addEventListener('input', jiaaraYoutubeApplyFilters);
  jiaaraSortSelect.addEventListener('change', jiaaraYoutubeApplyFilters);
  jiaaraLabelSelect.addEventListener('change', jiaaraYoutubeApplyFilters);

  // Toggle Panel Filter
  jiaaraFilterToggle.addEventListener('click', () => {
    jiaaraFilterPanel.classList.toggle('active');
  });

  // Jalankan inisialisasi saat halaman selesai dimuat
  document.addEventListener('DOMContentLoaded', jiaaraYoutubeInit);

</script>
