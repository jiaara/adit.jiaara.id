<script>
  (function() {
    // API Aladhan untuk Kabupaten Sukoharjo
    const skhcitizenWaktuSholatApiUrl = "https://api.aladhan.com/v1/timingsByCity?city=Sukoharjo&country=Indonesia&method=20";
    
    function skhcitizenWaktuSholatUpdateUI() {
      fetch(skhcitizenWaktuSholatApiUrl)
        .then(skhcitizenWaktuSholatResponse => skhcitizenWaktuSholatResponse.json())
        .then(skhcitizenWaktuSholatDataAPI => {
          if (skhcitizenWaktuSholatDataAPI.code === 200) {
            const skhcitizenWaktuSholatTimings = skhcitizenWaktuSholatDataAPI.data.timings;
            
            // Format Tanggal
            const skhcitizenWaktuSholatNow = new Date();
            const skhcitizenWaktuSholatDateOptions = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            const skhcitizenWaktuSholatDateString = skhcitizenWaktuSholatNow.toLocaleDateString('id-ID', skhcitizenWaktuSholatDateOptions);
            document.getElementById('skhcitizen-waktu-sholat-date-display').innerText = skhcitizenWaktuSholatDateString;

            // List waktu
            const skhcitizenWaktuSholatList = [
              { id: 'Imsak', label: 'Imsak' },
              { id: 'Fajr', label: 'Subuh' },
              { id: 'Sunrise', label: 'Terbit' },
              { id: 'Dhuhr', label: 'Zuhur' },
              { id: 'Asr', label: 'Ashar' },
              { id: 'Maghrib', label: 'Maghrib' },
              { id: 'Isha', label: 'Isya' }
            ];

            let skhcitizenWaktuSholatHtml = '';
            let skhcitizenWaktuSholatNextIndex = -1;
            let skhcitizenWaktuSholatParsedData = [];

            // Parsing waktu
            skhcitizenWaktuSholatList.forEach(skhcitizenWaktuSholatItem => {
              const skhcitizenWaktuSholatTimeStr = skhcitizenWaktuSholatTimings[skhcitizenWaktuSholatItem.id];
              const [skhcitizenWaktuSholatHour, skhcitizenWaktuSholatMinute] = skhcitizenWaktuSholatTimeStr.split(':');
              const skhcitizenWaktuSholatTimeObj = new Date();
              skhcitizenWaktuSholatTimeObj.setHours(parseInt(skhcitizenWaktuSholatHour), parseInt(skhcitizenWaktuSholatMinute), 0, 0);
              
              skhcitizenWaktuSholatParsedData.push({
                label: skhcitizenWaktuSholatItem.label,
                timeStr: skhcitizenWaktuSholatTimeStr,
                timeObj: skhcitizenWaktuSholatTimeObj
              });
            });

            // Cari indeks waktu berikutnya
            for (let i = 0; i < skhcitizenWaktuSholatParsedData.length; i++) {
              if (skhcitizenWaktuSholatParsedData[i].timeObj > skhcitizenWaktuSholatNow) {
                skhcitizenWaktuSholatNextIndex = i;
                break;
              }
            }

            // Render HTML
            skhcitizenWaktuSholatParsedData.forEach((skhcitizenWaktuSholatItem, skhcitizenWaktuSholatIndex) => {
              let skhcitizenWaktuSholatStatusClass = '';

              if (skhcitizenWaktuSholatNextIndex === -1) {
                if (skhcitizenWaktuSholatIndex === skhcitizenWaktuSholatParsedData.length - 1) {
                  skhcitizenWaktuSholatStatusClass = 'skhcitizen-waktu-sholat-current';
                } else {
                  skhcitizenWaktuSholatStatusClass = 'skhcitizen-waktu-sholat-passed';
                }
              } else if (skhcitizenWaktuSholatIndex < skhcitizenWaktuSholatNextIndex - 1) {
                skhcitizenWaktuSholatStatusClass = 'skhcitizen-waktu-sholat-passed';
              } else if (skhcitizenWaktuSholatIndex === skhcitizenWaktuSholatNextIndex - 1) {
                skhcitizenWaktuSholatStatusClass = 'skhcitizen-waktu-sholat-current';
              } else {
                skhcitizenWaktuSholatStatusClass = 'skhcitizen-waktu-sholat-upcoming';
              }

              skhcitizenWaktuSholatHtml += `
                <div class="skhcitizen-waktu-sholat-item ${skhcitizenWaktuSholatStatusClass}">
                  <span class="skhcitizen-waktu-sholat-label">${skhcitizenWaktuSholatItem.label}</span>
                  <span class="skhcitizen-waktu-sholat-time">${skhcitizenWaktuSholatItem.timeStr}</span>
                </div>
              `;
            });

            document.getElementById('skhcitizen-waktu-sholat-times-display').innerHTML = skhcitizenWaktuSholatHtml;
          }
        })
        .catch(skhcitizenWaktuSholatError => {
          document.getElementById('skhcitizen-waktu-sholat-times-display').innerHTML = '<span style="color:red; font-size:11px;">Gagal memuat jadwal sholat.</span>';
        });
    }

    skhcitizenWaktuSholatUpdateUI();
    setInterval(skhcitizenWaktuSholatUpdateUI, 60000);
  })();
</script>]]></b:widget-setting>
