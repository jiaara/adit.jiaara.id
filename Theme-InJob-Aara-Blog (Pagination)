    const skhcitizen_track = document.getElementById('skhcitizen-track');
    let skhcitizen_items = Array.from(skhcitizen_track.children);
    const skhcitizen_originalCount = skhcitizen_items.length;

    // Kloning item untuk infinite loop
    skhcitizen_items.forEach(item => {
        let clone = item.cloneNode(true);
        skhcitizen_track.appendChild(clone);
    });

    function skhcitizenGetVisible() {
        return window.innerWidth <= 600 ? 2 : 5;
    }

    function skhcitizenUpdateSlider(animate = true) {
        const visible = skhcitizenGetVisible();
        const stepWidth = 100 / visible;
        
        if (!animate) {
            skhcitizen_track.style.transition = 'none';
        } else {
            skhcitizen_track.style.transition = 'transform 0.5s ease-in-out';
        }

        skhcitizen_track.style.transform = `translateX(-${skhcitizen_currentIdx * stepWidth}%)`;
    }

    window.skhcitizenMoveSlider = function(step) {
        const visible = skhcitizenGetVisible();
        skhcitizen_currentIdx += step;

