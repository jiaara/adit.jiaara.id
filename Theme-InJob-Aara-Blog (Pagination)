      pageStart = currentPageNo - pageNumber;
      if (pageStart < 1) pageStart = 1;
      lastPageNo = parseInt(pageInfo / perPage) + 1;
      if (lastPageNo - 1 == pageInfo / perPage) lastPageNo = lastPageNo - 1;
      pageEnd = pageStart + numPages - 1;
      if (pageEnd > lastPageNo) pageEnd = lastPageNo;
      html += "<span class='showpageOf'>Page " + currentPageNo + ' of ' + lastPageNo + "</span>";
      
      var prevNumber = parseInt(currentPageNo) - 1;

      // Tombol First
      if (currentPageNo > 1) {
          html += '<span class="showpage firstpage"><a href="' + (currentPage == "page" ? home_page : "/search/label/" + postLabel + "?&max-results=" + perPage) + '">' + firstText + '</a></span>';
      }

      // Loop Angka
      for (var jj = pageStart; jj <= pageEnd; jj++) {
          if (currentPageNo == jj) {
              html += '<span class="pagecurrent">' + jj + '</span>';
          } else if (jj < currentPageNo) {
              // ANGKA SUDAH LEWAT (Class: page-passed)
              if (jj == 1) {
                  html += '<span class="displaypageNum page-passed"><a href="' + (currentPage == "page" ? home_page : "/search/label/" + postLabel + "?&max-results=" + perPage) + '">1</a></span>';
              } else {
                  html += '<span class="displaypageNum page-passed"><a href="#" onclick="' + (currentPage == "page" ? "redirectpage" : "redirectlabel") + '(' + jj + ');return false">' + jj + '</a></span>';
              }
          } else {
              // ANGKA SELANJUTNYA (Class: page-future)
              html += '<span class="displaypageNum page-future"><a href="#" onclick="' + (currentPage == "page" ? "redirectpage" : "redirectlabel") + '(' + jj + ');return false">' + jj + '</a></span>';
          }
      }

      // Tombol Last
      if (currentPageNo < lastPageNo) {
          html += '<span class="displaypageNum lastpage"><a href="#" onclick="' + (currentPage == "page" ? "redirectpage" : "redirectlabel") + '(' + lastPageNo + ');return false">' + lastText + '</a></span>';
      }

      var blogPager = document.getElementById("blog-pager");
      if (blogPager) { blogPager.innerHTML = html; }
  }

  function totalcountdata(root) {
      var feed = root.feed;
      var totaldata = parseInt(feed.openSearch$totalResults.$t, 10);
      looppagecurrentg(totaldata)
  }

  function pagecurrentg() {
      var thisUrl = location.href;
      var home_page_clean = window.location.protocol + "//" + window.location.hostname + "/";
      
      // Deteksi Halaman Posting (Single Post) - Jangan jalankan pagination jika ada .html
      if (thisUrl.indexOf(".html") != -1) return;

      // 1. Tentukan apakah ini halaman Label atau Beranda
      if (thisUrl.indexOf("/search/label/") != -1) {
          currentPage = "label";
          if (thisUrl.indexOf("?updated-max") != -1) {
              postLabel = thisUrl.substring(thisUrl.indexOf("/search/label/") + 14, thisUrl.indexOf("?updated-max"));
          } else {
              postLabel = thisUrl.substring(thisUrl.indexOf("/search/label/") + 14, thisUrl.indexOf("?&max"));
          }
      } else {
          currentPage = "page";
      }

      // 2. Tentukan nomor halaman sekarang
      if (thisUrl.indexOf("#PageNo=") != -1) {
          currentPageNo = parseInt(thisUrl.substring(thisUrl.indexOf("#PageNo=") + 8, thisUrl.length));
      } else {
          currentPageNo = 1;
      }

      // 3. Panggil Feed Blogger untuk menghitung total postingan
      var feedUrl = "";
      if (currentPage == "label") {
          feedUrl = "/feeds/posts/summary/-/" + postLabel + "?alt=json-in-script&callback=totalcountdata&max-results=1";
      } else {
          feedUrl = "/feeds/posts/summary?alt=json-in-script&callback=totalcountdata&max-results=1";
      }

      // Gunakan metode append script agar lebih aman
      var scriptPagination = document.createElement('script');
      scriptPagination.src = feedUrl;
      document.body.appendChild(scriptPagination);
  }

  function redirectpage(numberpage) {
      jsonstart = (numberpage - 1) * perPage;
      noPage = numberpage;
      var nameBody = document.getElementsByTagName('head')[0];
      var newInclude = document.createElement('script');
      newInclude.type = 'text/javascript';
      newInclude.setAttribute("src", home_page + "feeds/posts/summary?start-index=" + jsonstart + "&max-results=1&alt=json-in-script&callback=finddatepost");
      nameBody.appendChild(newInclude)
  }

  function redirectlabel(numberpage) {
      jsonstart = (numberpage - 1) * perPage;
      noPage = numberpage;
      var nameBody = document.getElementsByTagName('head')[0];
      var newInclude = document.createElement('script');
      newInclude.type = 'text/javascript';
      newInclude.setAttribute("src", home_page + "feeds/posts/summary/-/" + postLabel + "?start-index=" + jsonstart + "&max-results=1&alt=json-in-script&callback=finddatepost");
      nameBody.appendChild(newInclude)
  }

  function finddatepost(root) {
          post = root.feed.entry[0];
          var timestamp1 = post.published.$t.substring(0, 19) + post.published.$t.substring(23, 29);
          var timestamp = encodeURIComponent(timestamp1);
          if (currentPage == "page") {
              var pAddress = "/search?updated-max=" + timestamp + "&max-results=" + perPage + "#PageNo=" + noPage
          } else {
              var pAddress = "/search/label/" + postLabel + "?updated-max=" + timestamp + "&max-results=" + perPage + "#PageNo=" + noPage
          }
          location.href = pAddress
      }
