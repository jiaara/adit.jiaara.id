background-repeat: no-repeat;
background-position: bottom right;
}
img {
    max-width: 100%;
    vertical-align: middle;
    border: 0;
}
.widget iframe, .widget img {
    max-width: 100%;
}
.status-msg-border {
border: 1px solid #ff545a;
background:$maincolor;
}
.status-msg-body {
    color: $darkcolor;
