/* CSS Thumbnail Postingan Utama Beranda */
.index .post, .archive .post {
    display: flex;
    margin-bottom: 25px;
    padding-bottom: 20px;
    border-bottom: 1px solid #eee;
}

.post-home-image {
    width: 250px; /* Ukuran lebar gambar desktop */
    height: auto; /* Dibuat auto agar menyesuaikan rasio */
    aspect-ratio: 16 / 9; /* Mengunci rasio ke 16:9 */
    margin-right: 20px;
    overflow: hidden;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f5f5f5; /* Opsional: warna background jika gambar tidak pas 16:9 */
}

.post-home-image img {
    width: 100%;
    height: 100%;
    /* Gunakan 'contain' agar gambar tidak terpotong sama sekali. 
       Jika gambar asli Anda sudah 16:9, Anda bisa tetap menggunakan 'cover' */
    object-fit: contain; 
    transition: all .3s ease;
}

.post-home-image img:hover {
    transform: scale(1.1);
}

.post-info-container {
    flex-grow: 1;
}

.post-info-container h2.post-title {
    margin: 0 0 10px 0 !important;
    font-size: 18px !important;
