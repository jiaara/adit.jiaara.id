<script>
// Fungsi untuk mengganti visual Tab dan konten Panel
function switchTab71aara(event, langId) {
  // 1. Mengubah status tombol tab
  const wrapper = event.target.closest('.css71aara-Syntax-highlighter-wrapper');
  const tabs = wrapper.querySelectorAll('.css71aara-Syntax-highlighter-tab');
  tabs.forEach(tab => tab.classList.remove('active'));
  event.target.classList.add('active');

  // 2. Menyembunyikan semua panel dan menampilkan yang diklik
  const panes = wrapper.querySelectorAll('.css71aara-Syntax-highlighter-pane');
  panes.forEach(pane => pane.classList.remove('active'));
  wrapper.querySelector('#css71aara-pane-' + langId).classList.add('active');
}

// Fungsi untuk fitur tombol Salin Kode
function copyCode71aara(button) {
  // Mencari elemen <pre> di dalam panel (pane) yang sedang aktif
  const preElement = button.closest('.css71aara-Syntax-highlighter-pane').querySelector('.css71aara-Syntax-highlighter-pre');
  
  // Mengambil teks murni
  const codeText = preElement.innerText || preElement.textContent;
  
  navigator.clipboard.writeText(codeText).then(() => {
    const originalIcon = button.innerHTML;
    // Mengubah ikon menjadi ceklis hijau
    button.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
    
    // Kembalikan ke ikon semula setelah 2 detik
    setTimeout(() => {
      button.innerHTML = originalIcon;
    }, 2000);
  }).catch(err => {
    console.error('Gagal menyalin kode: ', err);
  });
}
</script>
