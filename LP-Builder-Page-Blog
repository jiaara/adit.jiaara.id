<!--JAVASCRIPT-->
<script>
    // Konfigurasi Label Blogger (Ganti "series" jika nama label berbeda)
    const jiaara_blog_series_label = "series-headline";
    // Jumlah maksimal postingan yang ditarik
    const jiaara_blog_series_maxResult = 12;

    // Fungsi Callback JSONP untuk mengambil data dari API Blogger
    window.jiaaraBlogSeriesCallback = function(json) {
        const track = document.getElementById('jiaara-blog-series-track');
        let html = '';

        if (json.feed && json.feed.entry) {
            const entries = json.feed.entry;
            
            for (let i = 0; i < entries.length; i++) {
                const entry = entries[i];
                let title = entry.title.$t;
                let postUrl = '';
                let imgUrl = '';

                // 1. Dapatkan URL Postingan
                for (let j = 0; j < entry.link.length; j++) {
                    if (entry.link[j].rel === 'alternate') {
                        postUrl = entry.link[j].href;
                        break;
                    }
                }

                // 2. Dapatkan URL Gambar (Internal/Upload maupun Eksternal)
                if ('media$thumbnail' in entry) {
                    // Jika dari Blogger, ubah ukuran resolusi (Blogger Image Hack)
                    // Mengubah s72-c menjadi w600-h750-c untuk memaksa ukuran resolusi tinggi 4:5
                    imgUrl = entry.media$thumbnail.url.replace(/\/s[0-9]+(\-c)?\//, '/w600-h750-c/');
                } else if ('content' in entry) {
                    // Jika tidak ada thumbnail, cari gambar pertama di dalam konten postingan
                    const htmlContent = entry.content.$t;
                    const imgMatch = htmlContent.match(/<img[^>]+src="([^">]+)"/);
                    if (imgMatch && imgMatch[1]) {
                        imgUrl = imgMatch[1];
                    }
                }

                // Fallback gambar jika postingan benar-benar tidak ada gambar
                if (!imgUrl) {
                    imgUrl = 'data:image/svg+xml;base64,';
                }

                // Bangun HTML Card
                html += `
                    <a href="${postUrl}" class="jiaara-blog-series-item" title="${title}">
                        <div class="jiaara-blog-series-img-wrap">
                            <img src="${imgUrl}" alt="${title}" loading="lazy">
                        </div>
                        <div class="jiaara-blog-series-post-title">${title}</div>
                    </a>
                `;
            }
        } else {
            html = '<div style="padding: 20px 0; color: #666;">Tidak ada postingan dalam series ini. Pastikan label "series" sudah ditambahkan pada postingan Anda.</div>';
        }

        // Masukkan HTML ke dalam track slider
        track.innerHTML = html;
        
        // Aktifkan Fungsi Tombol Navigasi
        jiaara_blog_series_initNavigation();
    };

    // Fungsi untuk mengaktifkan tombol kanan dan kiri
    function jiaara_blog_series_initNavigation() {
        const track = document.getElementById('jiaara-blog-series-track');
        const prevBtn = document.getElementById('jiaara-blog-series-prev');
        const nextBtn = document.getElementById('jiaara-blog-series-next');
        
        if (!track || !prevBtn || !nextBtn) return;

        // Ambil lebar satu item beserta gap-nya (20px)
        const getScrollAmount = () => {
            const item = track.querySelector('.jiaara-blog-series-item');
            return item ? item.offsetWidth + 20 : 300; 
        };

        nextBtn.addEventListener('click', () => {
            track.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
        });

        prevBtn.addEventListener('click', () => {
            track.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
        });
    }

    // Fungsi Injector Script API Blogger
    (function() {
        const script = document.createElement('script');
        // URL API Blogger JSONP (Hanya mengambil feed ringkasan/summary)
        script.src = `/feeds/posts/summary/-/${jiaara_blog_series_label}?alt=json-in-script&callback=jiaaraBlogSeriesCallback&max-results=${jiaara_blog_series_maxResult}`;
        document.body.appendChild(script);
    })();
</script>



<div id="jiaara-blog-kategori-wrapper">
    <div class="jiaara-blog-kategori-header">Blog Terbaru</div>
    <div id="jiaara-blog-kategori-list">
        <!--List postingan akan dimuat di sini oleh JavaScript-->
    </div>
    <div id="jiaara-blog-kategori-pagination">
        <!--Tombol pagination akan dimuat di sini-->
    </div>
</div>

<script>
    // Konfigurasi Utama
    const jiaara_blog_kategori_config = {
        postsPerPage: 10, // Sesuai dengan jumlah baris di gambar (bisa diubah)
        currentPage: 1,
        totalPosts: 0,
        mainLabel: 'blog', // Label Utama
        redLabels: ['headline', 'series'], // Label yang menghasilkan warna merah
        excludedBlueLabels: ['headline', 'headline1', 'headline2', 'series', 'blog', 'series-headline'] // Label yang dilarang tampil di warna biru
    };

    // Fungsi Fetch dari Blogger API
    function jiaara_blog_kategori_fetchPosts(page) {
        jiaara_blog_kategori_config.currentPage = page;
        const startIndex = (page - 1) * jiaara_blog_kategori_config.postsPerPage + 1;
        
        // URL Feed JSON Blogger
        const url = `/feeds/posts/default/-/${jiaara_blog_kategori_config.mainLabel}?alt=json&start-index=${startIndex}&max-results=${jiaara_blog_kategori_config.postsPerPage}`;

        // Loading State
        document.getElementById('jiaara-blog-kategori-list').innerHTML = '<div class="jiaara-blog-kategori-loading">Memuat postingan...</div>';

        fetch(url)
            .then(response => {
                if (!response.ok) throw new Error("Gagal mengambil data");
                return response.json();
            })
            .then(data => {
                const feed = data.feed;
                // Simpan total postingan untuk hitung pagination
                jiaara_blog_kategori_config.totalPosts = parseInt(feed.openSearch$totalResults.$t, 10);
                jiaara_blog_kategori_renderPosts(feed.entry || []);
                jiaara_blog_kategori_renderPagination();
            })
            .catch(error => {
                console.error(error);
                document.getElementById('jiaara-blog-kategori-list').innerHTML = '<div class="jiaara-blog-kategori-error">Gagal memuat atau tidak ada postingan dengan label "blog".</div>';
                document.getElementById('jiaara-blog-kategori-pagination').innerHTML = '';
            });
    }

    // Fungsi Render HTML Postingan ke dalam tabel
    function jiaara_blog_kategori_renderPosts(entries) {
        const listContainer = document.getElementById('jiaara-blog-kategori-list');
        listContainer.innerHTML = ''; 

        if (entries.length === 0) {
            listContainer.innerHTML = '<div class="jiaara-blog-kategori-loading">Tidak ada postingan ditemukan.</div>';
            return;
        }

        entries.forEach(entry => {
            const title = entry.title.$t;
            let link = '';
            
            // Ambil URL postingan
            for (let i = 0; i < entry.link.length; i++) {
                if (entry.link[i].rel === 'alternate') {
                    link = entry.link[i].href;
                    break;
                }
            }

            // Ambil semua label postingan
            const rawLabels = entry.category ? entry.category.map(cat => cat.term) : [];
            const labelsLowercase = rawLabels.map(l => l.toLowerCase());

            let redLabelHtml = '';
            let blueLabelHtml = '';

            // 1. Cek Label Merah ("headline" atau "series")
            const foundRedLabel = rawLabels.find(l => jiaara_blog_kategori_config.redLabels.includes(l.toLowerCase()));
            if (foundRedLabel) {
                redLabelHtml = `<span class="jiaara-blog-kategori-label-red">${foundRedLabel}</span>`;
            }

            // 2. Cek Label Biru (Selain yang dikecualikan)
            const foundBlueLabel = rawLabels.find(l => !jiaara_blog_kategori_config.excludedBlueLabels.includes(l.toLowerCase()));
            if (foundBlueLabel) {
                blueLabelHtml = `<span class="jiaara-blog-kategori-label-blue">${foundBlueLabel}</span>`;
            } else {
                 // Jika tidak ada label biru yang valid tapi ingin tetap menampilkan blok kosong biru (opsional agar rata)
                 // Bisa uncomment di bawah ini jika diperlukan. Berdasarkan gambar, selalu ada label biru.
                 // blueLabelHtml = `<span class="jiaara-blog-kategori-label-blue">label</span>`;
            }

            // Buat elemen Baris
            const row = document.createElement('div');
            row.className = 'jiaara-blog-kategori-item';
            row.innerHTML = `
                <a href="${link}" class="jiaara-blog-kategori-title" target="_blank">${title}</a>
                <div class="jiaara-blog-kategori-labels">
                    ${redLabelHtml}
                    ${blueLabelHtml}
                </div>
            `;
            listContainer.appendChild(row);
        });
    }

    // Fungsi Render Pagination
    function jiaara_blog_kategori_renderPagination() {
        const totalPages = Math.ceil(jiaara_blog_kategori_config.totalPosts / jiaara_blog_kategori_config.postsPerPage);
        const currentPage = jiaara_blog_kategori_config.currentPage;
        const paginationContainer = document.getElementById('jiaara-blog-kategori-pagination');
        paginationContainer.innerHTML = '';

        if (totalPages <= 1) return; 

        // Tombol Sebelumnya (Prev)
        const prevBtn = document.createElement('button');
        prevBtn.className = 'jiaara-blog-kategori-page-btn';
        prevBtn.innerHTML = '&laquo;';
        prevBtn.disabled = currentPage === 1;
        prevBtn.onclick = () => jiaara_blog_kategori_fetchPosts(currentPage - 1);
        paginationContainer.appendChild(prevBtn);

        // Angka Halaman (Max 5 angka berjejer agar rapi)
        let startPage = Math.max(1, currentPage - 2);
        let endPage = Math.min(totalPages, currentPage + 2);

        for (let i = startPage; i <= endPage; i++) {
            const pageBtn = document.createElement('button');
            pageBtn.className = `jiaara-blog-kategori-page-btn ${i === currentPage ? 'active' : ''}`;
            pageBtn.innerText = i;
            if (i !== currentPage) {
                pageBtn.onclick = () => jiaara_blog_kategori_fetchPosts(i);
            }
            paginationContainer.appendChild(pageBtn);
        }

        // Tombol Selanjutnya (Next)
        const nextBtn = document.createElement('button');
        nextBtn.className = 'jiaara-blog-kategori-page-btn';
        nextBtn.innerHTML = '&raquo;';
        nextBtn.disabled = currentPage === totalPages;
        nextBtn.onclick = () => jiaara_blog_kategori_fetchPosts(currentPage + 1);
        paginationContainer.appendChild(nextBtn);
    }

    // Inisialisasi Script saat halaman dimuat
    if (document.readyState === 'loading') {
        document.addEventListener("DOMContentLoaded", () => jiaara_blog_kategori_fetchPosts(1));
    } else {
        jiaara_blog_kategori_fetchPosts(1);
    }
</script>




