<style>
  /* ========== CSS TRENDING DAN HEADLINE ========== */
  /* --- WRAPPER UTAMA --- */
  #jiaara-blog-headline-wrapper {
    max-width: 85%;
    margin: 0 auto;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    color: #333;
    box-sizing: border-box;
  }
  #jiaara-blog-headline-wrapper * {
    box-sizing: border-box;
    text-decoration: none;
  }

  /* --- TRENDING BAR --- */
  .jiaara-blog-headline-trending-box {
    display: flex;
    align-items: center;
    background-color: #000;
    color: #fff;
    margin-bottom: 20px;
    height: 40px;
    overflow: hidden;
  }
  .jiaara-blog-headline-trending-label {
    background-color: #ff0000;
    color: #fff;
    font-weight: bold;
    padding: 0 20px;
    height: 100%;
    display: flex;
    align-items: center;
    font-size: 18px;
    letter-spacing: 1px;
    white-space: nowrap;
    z-index: 2;
  }
  .jiaara-blog-headline-trending-ticker {
    flex: 1;
    padding: 0 15px;
    font-style: italic;
    font-size: 15px;
  }
  .jiaara-blog-headline-trending-ticker a {
    color: #fff;
    transition: color 0.3s ease;
  }
  .jiaara-blog-headline-trending-ticker a:hover {
    color: #00b4ed;
  }

  /* --- SECTION TITLE --- */
  .jiaara-blog-headline-section-title {
    font-size: 24px;
    font-weight: bold;
    margin: 0 0 20px 0;
    padding-bottom: 5px;
    border-bottom: 2px solid #000;
    display: inline-block;
    text-transform: uppercase;
  }
  .jiaara-blog-headline-border-line {
    border-bottom: 1px solid #ddd;
    margin-top: -21px;
    margin-bottom: 20px;
  }

  /* --- LAYOUT GRID UTAMA --- */
  .jiaara-blog-headline-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 25px;
  }

  /* --- HEADLINE BESAR (KIRI) --- */
  .jiaara-blog-headline-main-post {
    position: relative;
    display: block; 
    width: 100%;
    aspect-ratio: 16 / 10; 
    border-radius: 2px;
    overflow: hidden;
    background-color: #eee;
  }
  .jiaara-blog-headline-main-post img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    margin: 0; 
    padding: 0;
  }
  .jiaara-blog-headline-main-tag {
    position: absolute;
    top: 20px;
    left: 20px;
    background-color: #43a8df;
    color: #fff;
    padding: 5px 12px;
    font-size: 14px;
    font-weight: bold;
    border-radius: 2px;
    z-index: 3;
  }
  .jiaara-blog-headline-gradient {
    position: absolute;
    bottom: 0; 
    left: 0;
    width: 100%;
    background: linear-gradient(to top, rgba(17, 172, 227, 1) 0%, rgba(17, 172, 227, 0.8) 50%, transparent 100%);
    padding: 80px 25px 25px 25px;
    z-index: 2;
    box-sizing: border-box;
  }
  .jiaara-blog-headline-main-title {
    color: #fff;
    font-size: 26px;
    font-weight: bold;
    margin: 0;
    line-height: 1.3;
    text-shadow: 1px 1px 3px rgba(0,0,0,0.3);
  }

  /* --- HEADLINE KECIL (KANAN) - PERBAIKAN AREA KLIK --- */
  .jiaara-blog-headline-small-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px 25px;
  }
  .jiaara-blog-headline-small-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid #333;
  }
  .jiaara-blog-headline-small-item:nth-last-child(-n+2) {
    border-bottom: none;
  }
  .jiaara-blog-headline-small-thumb {
    display: block; /* Diubah menjadi block karena sekarang menggunakan tag <a> */
    width: 100px;
    height: 80px;
    flex-shrink: 0;
    background-color: #e0f0ff;
    border-radius: 2px;
    overflow: hidden;
  }
  .jiaara-blog-headline-small-thumb img {
