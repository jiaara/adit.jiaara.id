    <!-- Teks Kode yang Disorot -->
    <pre class="css71aara-Syntax-highlighter-pre"><code class="css71aara-Syntax-highlighter-code">&lt;!DOCTYPE <span class="css71aara-Syntax-highlighter-c-attr">html</span>&gt;
