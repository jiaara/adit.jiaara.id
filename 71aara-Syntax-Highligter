  <!-- Area Konten Kode -->
  <div class="css71aara-Syntax-highlighter-content">
    <div class="css71aara-Syntax-highlighter-header">
      <span class="css71aara-Syntax-highlighter-filename">gilatemax/components/ui/syntax-highlighter.html</span>
      <button class="css71aara-Syntax-highlighter-copy-btn" onclick="copyCode71aara(this)" title="Salin Kode">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
