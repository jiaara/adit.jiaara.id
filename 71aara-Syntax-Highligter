<script>
// Fungsi untuk mengganti visual Tab yang aktif
function switchTab71aara(event) {
  const tabs = event.target.parentElement.querySelectorAll('.css71aara-Syntax-highlighter-tab');
  tabs.forEach(tab => tab.classList.remove('active'));
  event.target.classList.add('active');
}

// Fungsi untuk fitur tombol Salin Kode
function copyCode71aara(button) {
  // Mencari elemen <pre> yang berisi kode murni
  const preElement = button.closest('.css71aara-Syntax-highlighter-content').querySelector('.css71aara-Syntax-highlighter-pre');
  
  // Mengambil teks saja (tanpa elemen HTML <span> pewarnaan)
  const codeText = preElement.innerText || preElement.textContent;
  
  navigator.clipboard.writeText(codeText).then(() => {
    const originalIcon = button.innerHTML;
    // Mengubah ikon menjadi ceklis (berhasil disalin)
    button.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
    
    // Kembalikan ke ikon semula setelah 2 detik
    setTimeout(() => {
      button.innerHTML = originalIcon;
    }, 2000);
  }).catch(err => {
    console.error('Gagal menyalin kode: ', err);
  });
}
</script>


Panduan Mengubah Isi Kode
Jika Anda ingin mengganti script di dalamnya dengan kode milik Anda, ubah bagian yang berada di dalam tag <pre><code>...</code></pre>. Pastikan untuk mengubah karakter < menjadi &lt; dan > menjadi &gt; agar kode HTML tidak dieksekusi sebagai elemen nyata oleh browser.
