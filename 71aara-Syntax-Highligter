  <div class="css71aara-Syntax-highlighter-tabs">
    <button class="css71aara-Syntax-highlighter-tab active" onclick="switchTab71aara(event)">HTML</button>
    <button class="css71aara-Syntax-highlighter-tab" onclick="switchTab71aara(event)">CSS</button>
    <button class="css71aara-Syntax-highlighter-tab" onclick="switchTab71aara(event)">JavaScript</button>
