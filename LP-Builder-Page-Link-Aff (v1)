<!-- JAVASCRIPT UNTUK LOAD POSTINGAN OTOMATIS -->
<script>
    (function() {
        // Ambil data dari Blogger JSON Feed
        // URL ini mengambil 10 postingan terbaru secara otomatis
        const jiBioFeedUrl = '/feeds/posts/default?alt=json-in-script&max-results=10&callback=jiBioRenderPosts';
        
        // Buat Script Tag untuk JSONP
        const script = document.createElement('script');
        script.src = jiBioFeedUrl;
        document.body.appendChild(script);
    })();

    // Fungsi Callback untuk merender list
    function jiBioRenderPosts(json) {
        const container = document.getElementById('ji-bio-post-container');
        container.innerHTML = ''; // Hapus loading text

        if (!json.feed.entry) {
            container.innerHTML = '<div class="ji-bio-loading">Belum ada postingan.</div>';
            return;
        }

        json.feed.entry.forEach((entry, index) => {
            const title = entry.title.$t;
            let link = "";
            for (let i = 0; i < entry.link.length; i++) {
                if (entry.link[i].rel == 'alternate') {
                    link = entry.link[i].href;
                    break;
                }
            }

            // Ambil gambar (thumbnail)
            let thumbUrl = "https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiu3r1iE6f5G7P7m_D9eW_H_S3zH3/s1600/default-thumb.png";
            if (entry.media$thumbnail) {
                // Ubah ukuran thumbnail agar lebih tajam (s72-c jadi s200-c)
                thumbUrl = entry.media$thumbnail.url.replace('/s72-c/', '/s200-c/');
            }

            // Buat Element HTML
            const itemHtml = `
                <a href="${link}" class="ji-bio-product-item">
                    <div class="ji-bio-thumb">
                        <img src="${thumbUrl}" alt="${title}">
                    </div>
                    <div class="ji-bio-product-title">${index + 1}. ${title}</div>
                </a>
            `;
            
            container.innerHTML += itemHtml;
        });
    }
</script>
